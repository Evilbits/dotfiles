#!/usr/bin/env python3
"""
claude-sessions: fzf picker over every Claude Code session on this machine.

Rows come from the session transcripts under ~/.claude/projects (read-only) and
the live registry under ~/.claude/sessions. Enter jumps to a running session's
tmux pane, or resumes a closed one in a new tmux window in that project's
session. Nothing Claude owns is written; the index lives in ~/.cache.

Modes:
  claude-sessions              fzf picker (default)
  claude-sessions --list [--snoozed]   print rows (debug)
  claude-sessions --preview ID preview pane for one session
  claude-sessions --open ID    jump or resume
  claude-sessions --reindex    drop the cache and rebuild
  claude-sessions --ticket ID  print the primary ticket for one session (used by the status line)
  claude-sessions --snooze ID DURATION [REASON]   park a session until later (2h, 3d, tomorrow, fri, 14:30)
  claude-sessions --unsnooze ID
      ID may be "current": the session running in this tmux pane ($TMUX_PANE), so a
      Claude session can snooze itself from a Bash call.
  claude-sessions --statusline ID  one line for the status bar: ticket, own snooze, due count
  claude-sessions --wake       notify and reopen sessions whose snooze has expired (run by launchd); logs to ~/.local/state/claude-sessions/wake.log
  claude-sessions --due        print due and upcoming snoozed sessions, one per line (used by the SessionStart banner)
  claude-sessions --install-wake / --uninstall-wake   manage the launchd job (every minute)

In the picker: ctrl-s snoozes the highlighted session, ctrl-u unsnoozes, enter on a
snoozed or due session clears its snooze and opens it.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from collections import Counter

HOME = os.path.expanduser("~")
PROJECTS = os.path.join(HOME, ".claude", "projects")
REGISTRY = os.path.join(HOME, ".claude", "sessions")
CACHE = os.path.join(HOME, ".cache", "claude-sessions", "index.json")
SNOOZE = os.path.join(HOME, ".local", "state", "claude-sessions", "snooze.json")
PLIST = os.path.join(HOME, "Library", "LaunchAgents", "com.rasmusreiler.claude-sessions-wake.plist")
CLAUDE_BIN = shutil.which("claude") or os.path.join(HOME, ".local", "bin", "claude")

TICKET_RE = re.compile(r"\b(?:PROD|SEC|LAB|CS|PE|RESCOM|PR)-\d{2,6}\b")
MR_RE = re.compile(r"merge_requests/(\d{3,6})")
SKILL_RE = re.compile(r"<command-name>/?(doxy-[a-z]+)</command-name>")
ARGS_RE = re.compile(r"<command-args>([\s\S]*?)</command-args>")
REMINDER_RE = re.compile(r"<system-reminder>[\s\S]*?</system-reminder>")
TICKET_DENY = {"PROD-1234"}
JUNK_TITLE_RE = re.compile(r"^(please |i need|alternatively|base directory|review this pasted|want you to|then i)", re.I)
SKIP_DIRS = ("claude-rename-worker",)
PROMPT_KEEP = 8
PROMPT_CHARS = 400

# ── indexing ─────────────────────────────────────────────────────────────────

def load_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except Exception:
        return {}

def save_cache(cache):
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cache, f)
    os.replace(tmp, CACHE)

def new_state(session_id, project_dir):
    return {
        "id": session_id,
        "project_dir": project_dir,
        "cwd": "",
        "branch": "",
        "custom_title": "",
        "ai_title": "",
        "first_prompt": "",
        "prompts": [],
        "tickets": {},
        "tickets_assistant": {},
        "mrs": [],
        "skills": [],
        "first_ts": "",
        "last_ts": "",
        "turns": 0,
    }

def prompt_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
    return ""

def absorb_line(state, line):
    if '"type":"user"' in line and '"isMeta":true' not in line and '"isSidechain":true' not in line:
        try:
            rec = json.loads(line)
        except Exception:
            return
        if rec.get("type") != "user":
            return
        state["cwd"] = rec.get("cwd") or state["cwd"]
        state["branch"] = rec.get("gitBranch") or state["branch"]
        ts = rec.get("timestamp") or ""
        if ts:
            state["first_ts"] = state["first_ts"] or ts
            state["last_ts"] = ts
        text = prompt_text((rec.get("message") or {}).get("content"))
        if not text:
            return
        text = REMINDER_RE.sub("", text).strip()
        for m in SKILL_RE.findall(text):
            if m not in state["skills"]:
                state["skills"].append(m)
        args = ARGS_RE.search(text)
        if args:
            cmd = re.search(r"<command-name>(/?[a-z][a-z-]*)</command-name>", text)
            text = ((cmd.group(1).lstrip("/") and "/" + cmd.group(1).lstrip("/") + " ") if cmd else "") + args.group(1).strip()
        if not text or text.startswith("<"):
            return
        state["turns"] += 1
        for t in TICKET_RE.findall(text):
            if t not in TICKET_DENY:
                state["tickets"][t] = state["tickets"].get(t, 0) + 1
        for m in MR_RE.findall(text):
            if m not in state["mrs"]:
                state["mrs"].append(m)
        short = re.sub(r"\s+", " ", text)[:PROMPT_CHARS]
        state["first_prompt"] = state["first_prompt"] or short
        state["prompts"].append(short)
        del state["prompts"][:-PROMPT_KEEP]
        return
    if '"type":"assistant"' in line:
        for t in TICKET_RE.findall(line):
            if t not in TICKET_DENY:
                state["tickets_assistant"][t] = state["tickets_assistant"].get(t, 0) + 1
        return
    if '"type":"custom-title"' in line:
        try:
            state["custom_title"] = json.loads(line).get("customTitle") or state["custom_title"]
        except Exception:
            pass
        return
    if '"type":"ai-title"' in line:
        try:
            state["ai_title"] = json.loads(line).get("aiTitle") or state["ai_title"]
        except Exception:
            pass

def index_sessions(force=False):
    cache = {} if force else load_cache()
    seen = set()
    for project_dir in sorted(os.listdir(PROJECTS)):
        if any(s in project_dir for s in SKIP_DIRS):
            continue
        full = os.path.join(PROJECTS, project_dir)
        if not os.path.isdir(full):
            continue
        for name in os.listdir(full):
            if not name.endswith(".jsonl"):
                continue
            path = os.path.join(full, name)
            session_id = name[:-6]
            seen.add(path)
            st = os.stat(path)
            entry = cache.get(path)
            if entry and entry["size"] == st.st_size and entry["mtime"] == st.st_mtime:
                continue
            if entry and entry["size"] < st.st_size:
                state, offset = entry["state"], entry["size"]
            else:
                state, offset = new_state(session_id, project_dir), 0
            with open(path, "rb") as f:
                f.seek(offset)
                for raw in f:
                    try:
                        absorb_line(state, raw.decode("utf-8", "replace"))
                    except Exception:
                        pass
            cache[path] = {"size": st.st_size, "mtime": st.st_mtime, "state": state}
    for path in list(cache):
        if path not in seen:
            del cache[path]
    save_cache(cache)
    return [e["state"] for e in cache.values()], {e["state"]["id"]: e["mtime"] for e in cache.values()}

def ticket_for(session_id):
    """Cheap path for the status line: refresh only this session's entry."""
    import glob
    cache = load_cache()
    paths = glob.glob(os.path.join(PROJECTS, "*", session_id + ".jsonl"))
    if not paths:
        return ""
    path = paths[0]
    st_ = os.stat(path)
    entry = cache.get(path)
    if not entry or entry["size"] != st_.st_size or entry["mtime"] != st_.st_mtime:
        if entry and entry["size"] < st_.st_size:
            state, offset = entry["state"], entry["size"]
        else:
            state, offset = new_state(session_id, os.path.basename(os.path.dirname(path))), 0
        with open(path, "rb") as f:
            f.seek(offset)
            for raw in f:
                try:
                    absorb_line(state, raw.decode("utf-8", "replace"))
                except Exception:
                    pass
        cache[path] = {"size": st_.st_size, "mtime": st_.st_mtime, "state": state}
        save_cache(cache)
    return primary_ticket(cache[path]["state"])

# ── snooze ───────────────────────────────────────────────────────────────────

def load_snooze():
    try:
        with open(SNOOZE) as f:
            return json.load(f)
    except Exception:
        return {}

def save_snooze(data):
    os.makedirs(os.path.dirname(SNOOZE), exist_ok=True)
    tmp = SNOOZE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, SNOOZE)

WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]

def parse_until(spec, now=None):
    """2h, 45m, 3d, tomorrow, fri, 14:30 -> epoch seconds. Day-based specs land at 09:00."""
    import datetime as dt
    now = now or dt.datetime.now()
    s = spec.strip().lower()
    m = re.fullmatch(r"(\d+)\s*([smhd])", s)
    if m:
        n, unit = int(m.group(1)), m.group(2)
        if unit == "s":
            return (now + dt.timedelta(seconds=n)).timestamp()
        if unit == "d":
            return (now.replace(hour=9, minute=0, second=0, microsecond=0) + dt.timedelta(days=n)).timestamp()
        return (now + dt.timedelta(minutes=n if unit == "m" else n * 60)).timestamp()
    if s in ("tomorrow", "tmr"):
        return (now.replace(hour=9, minute=0, second=0, microsecond=0) + dt.timedelta(days=1)).timestamp()
    if s[:3] in WEEKDAYS:
        days = (WEEKDAYS.index(s[:3]) - now.weekday()) % 7 or 7
        return (now.replace(hour=9, minute=0, second=0, microsecond=0) + dt.timedelta(days=days)).timestamp()
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", s)
    if m:
        at = now.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        if at <= now:
            at += dt.timedelta(days=1)
        return at.timestamp()
    raise ValueError("cannot parse duration %r" % spec)

def fmt_until(ts):
    import datetime as dt
    at = dt.datetime.fromtimestamp(ts)
    today = dt.datetime.now().date()
    if at.date() == today:
        return at.strftime("%H:%M")
    if (at.date() - today).days < 7:
        return at.strftime("%a %H:%M")
    return at.strftime("%d %b %H:%M")

def remaining(ts):
    s = int(ts - time.time())
    if s <= 0:
        return "due"
    d, rem = divmod(s, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return "%dd %dh" % (d, h)
    if h:
        return "%dh %dm" % (h, m)
    return "%dm" % m if m else "<1m"

def resolve(session_id, states):
    """'current' -> the session whose tmux pane is the caller's; otherwise a (prefix of an) id."""
    if session_id == "current":
        pane = os.environ.get("TMUX_PANE", "")
        for sid, entry in live_sessions().items():
            if pane and (entry.get("tmux") or "").endswith("." + pane):
                return find(states, sid)
        return None
    return find(states, session_id)

def snooze(session_id, spec, reason):
    states, _ = index_sessions()
    st = resolve(session_id, states)
    if not st:
        sys.exit("unknown session " + session_id)
    data = load_snooze()
    data[st["id"]] = {"until": parse_until(spec), "reason": reason.strip(), "due": False}
    save_snooze(data)
    print("snoozed %s until %s (in %s)%s" % (primary_ticket(st) or st["id"][:8], fmt_until(data[st["id"]]["until"]), remaining(data[st["id"]]["until"]), (" · " + reason) if reason.strip() else ""))

def unsnooze(session_id):
    if session_id == "current":
        st = resolve("current", index_sessions()[0])
        if not st:
            sys.exit("no live session in this tmux pane")
        session_id = st["id"]
    data = load_snooze()
    for k in list(data):
        if k == session_id or k.startswith(session_id):
            del data[k]
    save_snooze(data)

def snooze_prompt(session_id):
    """Interactive prompt used from inside fzf (ctrl-s)."""
    states, _ = index_sessions()
    st = find(states, session_id)
    if not st:
        return
    print("snooze  %s  %s" % (primary_ticket(st), title_of(st)))
    try:
        spec = input("until (30s, 2h, 3d, tomorrow, fri, 14:30) [1d]: ").strip() or "1d"
        reason = input("reason (e.g. awaiting review on !17005): ").strip()
        snooze(st["id"], spec, reason)
    except (EOFError, KeyboardInterrupt, ValueError) as e:
        print(e)
        time.sleep(1)

WAKE_LOG = os.path.join(os.path.dirname(SNOOZE), "wake.log")

def log(msg):
    try:
        os.makedirs(os.path.dirname(WAKE_LOG), exist_ok=True)
        with open(WAKE_LOG, "a") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
    except Exception:
        pass

def notify(title, body):
    tn = shutil.which("terminal-notifier") or "/opt/homebrew/bin/terminal-notifier"
    if os.path.exists(tn):
        r = subprocess.run([tn, "-title", title, "-message", body, "-sound", "default", "-group", "claude-sessions"], capture_output=True, text=True)
        log("terminal-notifier exit %s %s" % (r.returncode, r.stderr.strip()))
    else:
        r = subprocess.run(["osascript", "-e", 'display notification "%s" with title "%s"' % (body.replace('"', "'"), title.replace('"', "'"))], capture_output=True, text=True)
        log("osascript exit %s %s" % (r.returncode, r.stderr.strip()))
    tmux("display-message", "-d", "8000", "%s: %s" % (title, body))

def due_lines():
    snoozed = load_snooze()
    if not snoozed:
        return []
    states, _ = index_sessions()
    out = []
    for sid, e in sorted(snoozed.items(), key=lambda kv: kv[1]["until"]):
        st = find(states, sid)
        if not st:
            continue
        left = remaining(e["until"])
        mark = "⏰ due" if left == "due" else "⏾ in " + left
        out.append("%s  %s  %s%s" % (fit(mark, 12), fit(primary_ticket(st), 10), title_of(st), ("  · " + e["reason"]) if e.get("reason") else ""))
    return out

def wake():
    data = load_snooze()
    if not data:
        return
    now = time.time()
    states, _ = index_sessions()
    live = live_sessions()
    changed = False
    for sid, entry in data.items():
        if entry.get("due") or entry["until"] > now:
            continue
        st = find(states, sid)
        label = (primary_ticket(st) + " · " if st and primary_ticket(st) else "") + (title_of(st) if st else sid[:8])
        log("due: %s" % label)
        notify("Claude session due", label + ((" — " + entry["reason"]) if entry.get("reason") else ""))
        if st and sid not in live and tmux("list-sessions").returncode == 0:
            open_session(sid)
            log("reopened %s in tmux" % sid[:8])
        entry["due"] = True
        changed = True
    if changed:
        save_snooze(data)

def install_wake():
    me = os.path.abspath(__file__)
    plist = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.rasmusreiler.claude-sessions-wake</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>%s</string><string>--wake</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict></plist>
""" % me
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    subprocess.run(["launchctl", "bootout", "gui/%d" % os.getuid(), PLIST], capture_output=True)
    with open(PLIST, "w") as f:
        f.write(plist)
    r = subprocess.run(["launchctl", "bootstrap", "gui/%d" % os.getuid(), PLIST], capture_output=True, text=True)
    print("installed wake job, every minute" if r.returncode == 0 else r.stderr)

def uninstall_wake():
    subprocess.run(["launchctl", "bootout", "gui/%d" % os.getuid(), PLIST], capture_output=True)
    if os.path.exists(PLIST):
        os.remove(PLIST)
    print("wake job removed")

# ── live registry ────────────────────────────────────────────────────────────

def live_sessions():
    live = {}
    if not os.path.isdir(REGISTRY):
        return live
    for name in os.listdir(REGISTRY):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(REGISTRY, name)) as f:
                d = json.load(f)
            os.kill(int(d["pid"]), 0)
        except Exception:
            continue
        live[d.get("sessionId", "")] = d
    return live

# ── presentation ─────────────────────────────────────────────────────────────

def age(mtime):
    s = int(time.time() - mtime)
    for unit, size in (("w", 604800), ("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return "%d%s" % (s // size, unit)
    return "now"

def primary_ticket(state):
    for source in (state["tickets"], {k: 1 for k in TICKET_RE.findall(state["ai_title"] + " " + state["custom_title"])}, state.get("tickets_assistant", {})):
        if source:
            return Counter(source).most_common(1)[0][0]
    m = TICKET_RE.search(state["branch"] or "")
    return m.group(0) if m else ""

def title_of(state):
    custom = state["custom_title"]
    if custom and JUNK_TITLE_RE.search(custom):
        custom = ""
    return custom or state["ai_title"] or state["first_prompt"][:70] or "(untitled)"

def project_of(state):
    cwd = state["cwd"]
    if not cwd:
        d = state["project_dir"]
        prefix = "-Users-rasmusreiler-"
        d = d[len(prefix):] if d.startswith(prefix) else d
        d = d[4:] if d.startswith("dev-") else d
        return d.split("--")[0]
    parts = [p for p in cwd.split("/") if p]
    try:
        i = parts.index("rasmusreiler")
    except ValueError:
        return parts[-1] if parts else "?"
    rest = parts[i + 1:]
    if rest and rest[0] == "dev" and len(rest) > 1:
        return rest[1]
    return rest[0] if rest else "?"

def skill_of(state):
    for s in state["skills"]:
        if s.startswith("doxy-"):
            return s[5:]
    return state["skills"][0] if state["skills"] else ""

def fit(s, n):
    s = s or ""
    return (s[: n - 1] + "…") if len(s) > n else s.ljust(n)

def rows(states, mtimes, live, only_snoozed=False):
    snoozed = load_snooze()
    if only_snoozed:
        states = [s for s in states if s["id"] in snoozed]
    def group(s):
        e = snoozed.get(s["id"])
        if e and (e.get("due") or e["until"] <= time.time()):
            return 0
        if e:
            return 2
        return 1 if s["id"] in live else 3
    def key(s):
        g = group(s)
        return (g, snoozed[s["id"]]["until"] if g == 2 else -mtimes.get(s["id"], 0))
    out = []
    for st in sorted(states, key=key):
        l = live.get(st["id"])
        e = snoozed.get(st["id"])
        marker = " "
        if e and (e.get("due") or e["until"] <= time.time()):
            marker = "⏰"
        elif e:
            marker = "z"
        elif l:
            marker = "●" if l.get("status") == "busy" else "○"
        title = title_of(st)
        if e:
            left = remaining(e["until"])
            title += "  %s%s" % ("⏰ due" if left == "due" else "⏾ in " + left, (" · " + e["reason"]) if e.get("reason") else "")
        mrs = " ".join("!" + m for m in st["mrs"][:2])
        line = "\t".join([
            st["id"],
            marker,
            fit(age(mtimes.get(st["id"], 0)), 4),
            fit(project_of(st), 12),
            fit(primary_ticket(st), 10),
            fit(skill_of(st), 9),
            fit(title, 64),
            fit(mrs, 14),
        ])
        out.append(line)
    return out

def footer(states):
    snoozed = load_snooze()
    if not snoozed:
        return ""
    lines = []
    for sid, e in sorted(snoozed.items(), key=lambda kv: kv[1]["until"]):
        st = find(states, sid)
        if not st:
            continue
        mark = "⏰ due" if e.get("due") or e["until"] <= time.time() else "in " + remaining(e["until"])
        lines.append("%s  %s  %s%s" % (fit(primary_ticket(st), 10), fit(mark, 9), fit(title_of(st), 44), ("  · " + e["reason"]) if e.get("reason") else ""))
    return "\n".join(lines)

def statusline(session_id):
    """ticket \t own-snooze-text \t due-count, for the status bar."""
    ticket = ticket_for(session_id)
    snoozed = load_snooze()
    own = snoozed.get(session_id)
    own_text = ""
    if own:
        own_text = ("⏰ due" if own.get("due") or own["until"] <= time.time() else "⏾ " + remaining(own["until"])) + ((" · " + own["reason"]) if own.get("reason") else "")
    due = sum(1 for e in snoozed.values() if e.get("due") or e["until"] <= time.time())
    print("%s\t%s\t%d" % (ticket, own_text, due))

def find(states, session_id):
    for st in states:
        if st["id"] == session_id or st["id"].startswith(session_id):
            return st
    return None

HDR = "\033[1;38;5;183m"
LBL = "\033[2m"
RST = "\033[0m"

def label(k, v):
    print(LBL + k.ljust(11) + RST + v)

def header(s):
    print(HDR + s + RST)

def preview(session_id):
    states, mtimes = index_sessions()
    st = find(states, session_id)
    if not st:
        print("unknown session", session_id)
        return
    l = live_sessions().get(st["id"])
    width = int(os.environ.get("FZF_PREVIEW_COLUMNS") or 80)
    import textwrap
    wrap = lambda s: "\n".join(textwrap.wrap(s, width - 2)) if s else ""
    print("\033[1m" + wrap(title_of(st)) + RST)
    if st["ai_title"] and st["ai_title"] != title_of(st):
        label("ai title", st["ai_title"])
    print()
    label("state", ("%s in tmux %s" % (l.get("status"), l.get("tmux"))) if l else "closed, resumable")
    if st["tickets"]:
        label("tickets", ", ".join(k for k, _ in Counter(st["tickets"]).most_common(6)))
    if st["mrs"]:
        label("MRs", ", ".join("!" + m for m in st["mrs"][:12]))
    if st["skills"]:
        label("skills", ", ".join(st["skills"]))
    if st["branch"]:
        label("branch", st["branch"])
    print()
    header("first prompt")
    print(wrap(st["first_prompt"]))
    print()
    header("recent prompts (newest on top)")
    for p in reversed(st["prompts"][-6:]):
        print(wrap("- " + p))
        print()

# ── actions ──────────────────────────────────────────────────────────────────

def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True)

def tmux_session_for(cwd):
    names = [n for n in tmux("list-sessions", "-F", "#S").stdout.split("\n") if n]
    for part in reversed([p for p in (cwd or "").split("/") if p]):
        if part in names:
            return part
    return os.environ.get("TMUX_PANE") and tmux("display-message", "-p", "#S").stdout.strip() or (names[0] if names else None)

def open_session(session_id):
    states, _ = index_sessions()
    st = resolve(session_id, states)
    if not st:
        sys.exit("unknown session " + session_id)
    unsnooze(st["id"])
    l = live_sessions().get(st["id"])
    if l and l.get("tmux"):
        target = l["tmux"]                      # e.g. doxyme-core:@7.%8
        sess = target.split(":")[0]
        window = target.split(".")[0]
        pane = target.split(".")[-1]
        tmux("switch-client", "-t", sess)
        tmux("select-window", "-t", window)
        tmux("select-pane", "-t", pane)
        return
    cwd = st["cwd"] if os.path.isdir(st["cwd"]) else HOME
    sess = tmux_session_for(cwd)
    name = primary_ticket(st) or st["id"][:8]
    cmd = "%s --resume %s" % (CLAUDE_BIN, st["id"])
    if sess:
        tmux("new-window", "-t", sess + ":", "-n", name, "-c", cwd, cmd)
        tmux("switch-client", "-t", sess)
    else:
        os.chdir(cwd)
        os.execvp(CLAUDE_BIN, [CLAUDE_BIN, "--resume", st["id"]])

def pick():
    states, mtimes = index_sessions()
    live = live_sessions()
    lines = rows(states, mtimes, live)
    if not lines:
        sys.exit("no sessions found")
    me = os.path.abspath(__file__)
    header = "   age  project      ticket     skill     title                                                            MRs             ⏰due ●busy ○idle z snoozed   order: due, live, snoozed, closed   ctrl-z snoozed only  ctrl-s snooze  ctrl-u unsnooze  ctrl-y copy id"
    fzf = subprocess.run(
        [
            "fzf", "--reverse", "--no-sort", "--delimiter", "\t", "--with-nth", "2..", "--tabstop", "1",
            "--header", header, "--header-first",
            "--preview", "%s --preview {1}" % me, "--preview-window", "right,50%,wrap",
            "--bind", "ctrl-y:execute-silent(printf %s {1} | pbcopy)",
            *(["--footer", footer(states), "--footer-border", "top", "--footer-label", " snoozed "] if footer(states) else []),
            "--bind", "ctrl-r:reload(%s --list)" % me,
            "--bind", "end:last,home:first",
            "--bind", "ctrl-z:transform:[ \"$FZF_PROMPT\" = 'snoozed> ' ] && echo 'change-prompt(> )+reload(%s --list)' || echo 'change-prompt(snoozed> )+reload(%s --list --snoozed)'" % (me, me),
            "--bind", "ctrl-s:execute(%s --snooze-prompt {1})+reload(%s --list)" % (me, me),
            "--bind", "ctrl-u:execute-silent(%s --unsnooze {1})+reload(%s --list)" % (me, me),
        ],
        input="\n".join(lines), capture_output=True, text=True,
    )
    choice = fzf.stdout.strip()
    if fzf.returncode != 0 or not choice:
        return
    open_session(choice.split("\t")[0])

def main(argv):
    os.environ["PATH"] = "/opt/homebrew/bin:/usr/local/bin:" + os.environ.get("PATH", "")
    if "--reindex" in argv:
        index_sessions(force=True)
        argv = [a for a in argv if a != "--reindex"]
    if not argv:
        return pick()
    if argv[0] == "--list":
        states, mtimes = index_sessions()
        print("\n".join(rows(states, mtimes, live_sessions(), only_snoozed="--snoozed" in argv)))
    elif argv[0] == "--preview" and len(argv) > 1:
        preview(argv[1])
    elif argv[0] == "--open" and len(argv) > 1:
        open_session(argv[1])
    elif argv[0] == "--ticket" and len(argv) > 1:
        print(ticket_for(argv[1]))
    elif argv[0] == "--statusline" and len(argv) > 1:
        statusline(argv[1])
    elif argv[0] == "--snooze" and len(argv) > 2:
        snooze(argv[1], argv[2], " ".join(argv[3:]))
    elif argv[0] == "--snooze-prompt" and len(argv) > 1:
        snooze_prompt(argv[1])
    elif argv[0] == "--unsnooze" and len(argv) > 1:
        unsnooze(argv[1])
    elif argv[0] == "--wake":
        wake()
    elif argv[0] == "--due":
        print("\n".join(due_lines()))
    elif argv[0] == "--install-wake":
        install_wake()
    elif argv[0] == "--uninstall-wake":
        uninstall_wake()
    else:
        print(__doc__)

if __name__ == "__main__":
    main(sys.argv[1:])
