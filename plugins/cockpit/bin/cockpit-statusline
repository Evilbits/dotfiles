#!/bin/sh
# Claude Code statusLine command: "<model> · <effort> | <repo> | <ticket> · <subject> | <snooze> | ⏰ N due | branch [primary|worktree] | !MR".
# Reads the JSON Claude pipes on stdin; asks cockpit for the ticket, the subject and the snooze state.
input=$(cat)
here=$(dirname "$(readlink "$0" || echo "$0")")
sessions="$here/cockpit"
accent=183; branchcol=116; linkcol=111

fields=$(printf '%s' "$input" | jq -r '[.model.display_name, (.workspace.current_dir // .cwd), (.effort.level // ""), (.session_name // ""), (.session_id // "")] | @tsv')
model=$(printf '%s' "$fields" | cut -f1)
dir=$(printf '%s' "$fields" | cut -f2)
effort=$(printf '%s' "$fields" | cut -f3)
session=$(printf '%s' "$fields" | cut -f4)
session_id=$(printf '%s' "$fields" | cut -f5)

# Resolve git first so the MR lookup can be keyed by branch.
git_info=$(git -C "$dir" rev-parse --path-format=absolute --git-dir --git-common-dir --show-toplevel --abbrev-ref HEAD 2>/dev/null) || git_info=""
branch=$(printf '%s\n' "$git_info" | sed -n 4p)
[ "$branch" = "HEAD" ] && branch="@$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"

ticket=""; own_snooze=""; due_count=0; mr_label=""; mr_url=""; subject=""; ticket_url=""
if [ -n "$session_id" ] && [ -x "$sessions" ]; then
  sl=$("$sessions" --statusline "$session_id" --dir "$dir" --branch "$branch" 2>/dev/null)
  ticket=$(printf '%s' "$sl" | cut -f1)
  own_snooze=$(printf '%s' "$sl" | cut -f2)
  due_count=$(printf '%s' "$sl" | cut -f3)
  accent=$(printf '%s' "$sl" | cut -f4); accent=${accent:-183}
  branchcol=$(printf '%s' "$sl" | cut -f5); branchcol=${branchcol:-116}
  mr_label=$(printf '%s' "$sl" | cut -f6)
  mr_url=$(printf '%s' "$sl" | cut -f7)
  subject=$(printf '%s' "$sl" | cut -f8)
  ticket_url=$(printf '%s' "$sl" | cut -f9)
fi
# cockpit's subject is the work without identifiers; Claude's own session name stands in when cockpit
# has not indexed the session yet.
[ -n "$subject" ] && session="$subject"
[ "${#session}" -gt 52 ] && session="$(printf '%.51s' "$session")…"

left="$model${effort:+ · $effort}"
name_seg=""
# The ticket leads the segment, underlined and clickable (OSC 8) when cockpit knows its Jira host.
ticket_seg=""
if [ -n "$ticket" ]; then
  if [ -n "$ticket_url" ]; then
    ticket_seg="$(printf '\033]8;;%s\033\\\033[4;38;5;%sm%s\033[0m\033]8;;\033\\' "$ticket_url" "$accent" "$ticket")"
  else
    ticket_seg="$(printf '\033[38;5;%sm%s\033[0m' "$accent" "$ticket")"
  fi
fi
if [ -n "$ticket_seg" ] && [ -n "$session" ]; then
  name_seg="$ticket_seg$(printf ' · \033[38;5;%sm%s\033[0m | ' "$accent" "$session")"
elif [ -n "$ticket_seg" ]; then
  name_seg="$ticket_seg | "
elif [ -n "$session" ]; then
  name_seg="$(printf '\033[38;5;%sm%s\033[0m | ' "$accent" "$session")"
fi
[ -n "$own_snooze" ] && name_seg="$name_seg$(printf '\033[2m%s\033[0m | ' "$own_snooze")"
[ "${due_count:-0}" -gt 0 ] 2>/dev/null && name_seg="$name_seg$(printf '\033[33m⏰ %s due\033[0m | ' "$due_count")"
# The session's MR, shown after the branch as an underlined link (OSC 8) in the link colour.
mr_seg=""
[ -n "$mr_label" ] && mr_seg="$(printf ' | \033]8;;%s\033\\\033[4;38;5;%sm%s\033[0m\033]8;;\033\\' "$mr_url" "$linkcol" "$mr_label")"

if [ -z "$git_info" ]; then
  printf '%s | %s | %s%s' "$left" "$(basename "$dir")" "${name_seg% | }" "$mr_seg"
  exit 0
fi
git_dir=$(printf '%s\n' "$git_info" | sed -n 1p)
common_dir=$(printf '%s\n' "$git_info" | sed -n 2p)
toplevel=$(printf '%s\n' "$git_info" | sed -n 3p)
repo=$(basename "$(dirname "$common_dir")")
if [ "$git_dir" != "$common_dir" ]; then
  folder=$(basename "$toplevel")
  [ "$folder" = "$branch" ] && label="worktree" || label="worktree: $folder"
  printf '%s | %s | %s\033[33m⧉ %s [%s]\033[0m%s' "$left" "$repo" "$name_seg" "$branch" "$label" "$mr_seg"
else
  printf '%s | %s | %s\033[38;5;%sm⎇ %s [primary]\033[0m%s' "$left" "$repo" "$name_seg" "$branchcol" "$branch" "$mr_seg"
fi
