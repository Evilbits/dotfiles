{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "args": ["--use-fake-ui-for-media-stream", "--use-fake-device-for-media-stream"]
    },
    "contextOptions": {
      "permissions": ["camera", "microphone"],
      "viewport": { "width": 1440, "height": 900 }
    }
  }
}
